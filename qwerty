-- УНИВЕРСАЛЬНЫЙ ПОИСК МОДЕЛИ ИГРОКА
local function isPlayerModel(obj, player)
    if not obj or not obj:IsA("Model") then return false end
    local uid = obj:GetAttribute("Player") or obj:GetAttribute("UserId")
        or obj:GetAttribute("Owner") or obj:GetAttribute("PlayerId")
    if uid ~= nil then
        if uid == player.UserId or uid == player.Name then return true end
    end
    if obj.Name == player.Name then return true end
    if obj.Name:find(player.Name, 1, true) then return true end
    return false
end

local function getPlayerModel(player)
    if player == LocalPlayer then return nil end
    local char = player.Character
    if char and char.Parent and char:FindFirstChildOfClass("Humanoid") then return char end
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
            if isPlayerModel(obj, player) then return obj end
        end
    end
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name == player.Name then return obj end
    end
    return char
end

local function getAnyHumanoid(model)
    if not model then return nil end
    return model:FindFirstChildOfClass("Humanoid")
        or (model.Parent and model.Parent:FindFirstChildOfClass("Humanoid"))
end

local function getAnyPart(model, preferName)
    if not model then return nil end
    if preferName then
        local p = model:FindFirstChild(preferName)
        if p and p:IsA("BasePart") then return p end
    end
    local hrp = model:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then return hrp end
    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BasePart") then return obj end
    end
    return nil
end

-- TEAM
local function isSameTeam(p1, p2)
    if p1 == p2 then return true end
    local t1, t2 = p1.Team, p2.Team
    if t1 ~= nil and t2 ~= nil then return t1 == t2 end
    local a1 = p1:GetAttribute("Team") or p1:GetAttribute("TeamName")
    local a2 = p2:GetAttribute("Team") or p2:GetAttribute("TeamName")
    if a1 ~= nil and a2 ~= nil then return a1 == a2 end
    return false
end

local function shouldShow(player)
    if player == LocalPlayer then return false end
    if CONFIG.ESP_TeamCheck and isSameTeam(player, LocalPlayer) then return false end
    return true
end

local function effectiveVisible(player)
    if not VISIBILITY_ENABLED then return true end
    local v = visibility[player]
    if v == nil then return true end
    return v == true
end

local function getESPColor(player)
    if CONFIG.TeamColorESP and player.Team then
        return player.TeamColor.Color
    end
    return effectiveVisible(player) and CONFIG.VisibleColor or CONFIG.HiddenColor
end

local function getAlertColor(player)
    if CONFIG.TeamColorESP and player.Team then
        return player.TeamColor.Color
    end
    if not VISIBILITY_ENABLED then
        return Color3.fromRGB(0, 255, 0)
    end
    local vis = visibility[player]
    if vis == nil then vis = true end
    return vis and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
end

-- VISIBILITY
local function raycastVisible(targetModel, checkPoint)
    if not targetModel or not checkPoint then return false end
    local camPos = Camera.CFrame.Position
    local dir = checkPoint.Position - camPos
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    params.IgnoreWater = true
    local result = Workspace:Raycast(camPos, dir, params)
    if not result then return true end
    if result.Instance:IsDescendantOf(targetModel) then return true end
    return false
end

local function checkVisibility(player)
    if not shouldShow(player) then return false end
    local model = getPlayerModel(player)
    if not model then return false end
    local head = model:FindFirstChild("Head") or getAnyPart(model, "Head")
    if head and raycastVisible(model, head) then return true end
    if not CONFIG.CheckHeadOnly then
        local torso = model:FindFirstChild("UpperTorso")
            or model:FindFirstChild("Torso")
            or getAnyPart(model)
        if torso and raycastVisible(model, torso) then return true end
    end
    return false
end

-- HIGHLIGHT
local function removeHighlightsFor(player)
    if highlights[player] then
        highlights[player]:Destroy()
        highlights[player] = nil
    end
end

local function addHighlightsFor(player)
    if not ESP_ENABLED or not shouldShow(player) then
        removeHighlightsFor(player)
        return
    end
    local model = getPlayerModel(player)
    if not model then return end
    removeHighlightsFor(player)
    
    if CONFIG.UseHighlight then
        local h = Instance.new("Highlight")
        h.Name = "ESP_HL_" .. player.Name
        h.OutlineColor = CONFIG.OutlineColor
        h.OutlineTransparency = CONFIG.OutlineTransparency
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Adornee = model
        h.Parent = Workspace
        highlights[player] = h
    end
end

local function updateHighlightColor(player)
    local h = highlights[player]
    if not h or not h.Parent then return end
    
    if CONFIG.TeamColorESP and player.Team then
        h.FillColor = player.TeamColor.Color
        if VISIBILITY_ENABLED and visibility[player] == true then
            h.FillTransparency = 1
        else
            h.FillTransparency = CONFIG.Transparency
        end
    else
        h.FillColor = effectiveVisible(player) and CONFIG.VisibleColor or CONFIG.HiddenColor
        h.FillTransparency = CONFIG.Transparency
    end
    h.OutlineColor = CONFIG.OutlineColor
end

local function applyHighlightStyles()
    for p, h in pairs(highlights) do
        if h and h.Parent then
            updateHighlightColor(p)
            h.OutlineTransparency = CONFIG.OutlineTransparency
        end
    end
end

-- TRACER
local function applyTracerStyles()
    for p, line in pairs(tracers) do
        pcall(function()
            line.Thickness = CONFIG.TracerThickness
            line.Transparency = CONFIG.TracerTransparency
            line.Color = getESPColor(p)
        end)
    end
end

local function getTracer(player)
    if not CONFIG.TracerEnabled then return nil end
    if not tracers[player] then
        local ok, line = pcall(function() return Drawing.new("Line") end)
        if not ok or not line then return nil end
        line.Thickness = CONFIG.TracerThickness
        line.Transparency = CONFIG.TracerTransparency
        line.Color = getESPColor(player)
        line.Visible = false
        tracers[player] = line
    end
    return tracers[player]
end

local function removeTracer(player)
    if tracers[player] then
        pcall(function() tracers[player]:Remove() end)
        tracers[player] = nil
    end
end

-- BOX + HP
local function makeESPDrawings()
    local ok = pcall(function() return Drawing.new("Square") end)
    if not ok then return nil end
    local box = Drawing.new("Square"); box.Filled = false; box.Visible = false
    local hpBg = Drawing.new("Square"); hpBg.Filled = true; hpBg.Color = Color3.fromRGB(0, 0, 0); hpBg.Visible = false
    local hpFill = Drawing.new("Square"); hpFill.Filled = true; hpFill.Visible = false
    local hpText = Drawing.new("Text")
    hpText.Center = true; hpText.Outline = true; hpText.OutlineColor = Color3.fromRGB(0, 0, 0)
    hpText.Size = 13; hpText.Font = Drawing.Fonts.UI; hpText.Visible = false
    local distText = Drawing.new("Text")
    distText.Center = true; distText.Outline = true; distText.OutlineColor = Color3.fromRGB(0, 0, 0)
    distText.Size = 13; distText.Font = Drawing.Fonts.UI; distText.Visible = false
    return { box = box, hpBg = hpBg, hpFill = hpFill, hpText = hpText, distText = distText }
end

local function getESPDrawings(player)
    if not espObjects[player] then espObjects[player] = makeESPDrawings() end
    return espObjects[player]
end

local function removeESPDrawings(player)
    local d = espObjects[player]
    if d then
        for _, obj in pairs(d) do pcall(function() obj:Remove() end) end
        espObjects[player] = nil
    end
end

local function hideESPDrawings(player)
    local d = espObjects[player]
    if not d then return end
    d.box.Visible = false; d.hpBg.Visible = false
    d.hpFill.Visible = false; d.hpText.Visible = false; d.distText.Visible = false
end

local function updateESPDrawings(player)
    local d = getESPDrawings(player)
    if not d then return end
    if not ESP_ENABLED or not shouldShow(player) then hideESPDrawings(player); return end
    local model = getPlayerModel(player)
    if not model then hideESPDrawings(player); return end
    local hum = getAnyHumanoid(model)
    if not hum then hideESPDrawings(player); return end

    local headPart = model:FindFirstChild("Head") or getAnyPart(model, "Head")
    local rootPart = model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or getAnyPart(model)

    if not headPart or not rootPart then
        local top, bot
        for _, obj in ipairs(model:GetDescendants()) do
            if obj:IsA("BasePart") then
                if not top or obj.Position.Y > top.Position.Y then top = obj end
                if not bot or obj.Position.Y < bot.Position.Y then bot = obj end
            end
        end
        headPart = headPart or top; rootPart = rootPart or bot
    end

    if not headPart then hideESPDrawings(player); return end
    local topPos = headPart.Position + Vector3.new(0, 0.6, 0)
    local hip = hum.HipHeight or 2.5
    local botPos = Vector3.new(rootPart.Position.X, rootPart.Position.Y - hip, rootPart.Position.Z)
    
    local spTop = Camera:WorldToViewportPoint(topPos)
    local spBot = Camera:WorldToViewportPoint(botPos)
    
    if spTop.Z <= 0 and spBot.Z <= 0 then hideESPDrawings(player); return end

    local topX, topY, topZ = spTop.X, spTop.Y, spTop.Z
    local botX, botY, botZ = spBot.X, spBot.Y, spBot.Z
    
    local vp = Camera.ViewportSize
    if math.abs(topX) > vp.X * 5 or math.abs(topY) > vp.Y * 5 or
       math.abs(botX) > vp.X * 5 or math.abs(botY) > vp.Y * 5 then
        hideESPDrawings(player)
        return
    end

    if topZ <= 0 then topY = botY - 100; topX = botX end
    if botZ <= 0 then botY = topY + 100; botX = topX end

    local yTop = math.min(topY, botY); local yBot = math.max(topY, botY)
    local boxH = yBot - yTop
    
    if boxH > vp.Y * 1.5 then hideESPDrawings(player); return end

    if boxH < 4 then
        local cy = (yTop + yBot) / 2
        yTop = cy - 2
        yBot = cy + 2
        boxH = 4
    end

    local boxW = boxH * CONFIG.BoxWidthRatio
    if boxW < 3 then boxW = 3 end

    local xCenter = (topX + botX) / 2
    local xLeft = xCenter - boxW / 2

    if xLeft < -vp.X * 2 or xLeft > vp.X * 3 then
        hideESPDrawings(player)
        return
    end

    local boxColor = getESPColor(player)

    if CONFIG.BoxEnabled then
        d.box.Visible = true
        d.box.Position = Vector2.new(xLeft, yTop)
        d.box.Size = Vector2.new(boxW, boxH)
        d.box.Thickness = CONFIG.BoxThickness
        d.box.Color = boxColor
        d.box.Transparency = CONFIG.BoxTransparency
    else
        d.box.Visible = false
    end

    local barH = CONFIG.HPBarHeight
    local hpPct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
    local barY = yTop - barH - 3

    if CONFIG.HPBarEnabled then
        d.hpBg.Visible = true
        d.hpBg.Position = Vector2.new(xLeft, barY)
        d.hpBg.Size = Vector2.new(boxW, barH)
        d.hpBg.Color = Color3.fromRGB(0, 0, 0)
        d.hpBg.Transparency = CONFIG.HPTransparency
        
        d.hpFill.Visible = true
        d.hpFill.Position = Vector2.new(xLeft, barY)
        d.hpFill.Size = Vector2.new(boxW * hpPct, barH)
        d.hpFill.Color = Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(60, 255, 60), hpPct)
        d.hpFill.Transparency = CONFIG.HPTransparency
    else
        d.hpBg.Visible = false; d.hpFill.Visible = false
    end

    if CONFIG.HPTextEnabled then
        d.hpText.Visible = true
        d.hpText.Position = Vector2.new(xLeft + boxW / 2, barY - 15)
        d.hpText.Text = string.format("%d / %d", math.floor(hum.Health + 0.5), math.floor(hum.MaxHealth + 0.5))
        d.hpText.Color = Color3.fromRGB(255, 255, 255)
        d.hpText.Transparency = CONFIG.HPTransparency
    else
        d.hpText.Visible = false
    end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("UpperTorso") or myChar:FindFirstChild("Torso"))
    local dist = 0
    if myRoot and rootPart then dist = (rootPart.Position - myRoot.Position).Magnitude end

    if CONFIG.DistTextEnabled then
        d.distText.Visible = true
        d.distText.Position = Vector2.new(xLeft + boxW / 2, yBot + 4)
        d.distText.Text = string.format("%d m", math.floor(dist + 0.5))
        d.distText.Color = Color3.fromRGB(255, 255, 255)
        d.distText.Transparency = CONFIG.HPTransparency
    else
        d.distText.Visible = false
    end
end

-- BACK ALERT
local alertGui = Instance.new("ScreenGui")
alertGui.Name = "ESP_BackAlert"
alertGui.IgnoreGuiInset = true
alertGui.ResetOnSpawn = false
alertGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local alertMarkers = {}

local function getAlertMarker(player)
    if alertMarkers[player] then return alertMarkers[player] end
    local f = Instance.new("Frame")
    f.Name = "Alert_" .. player.Name
    f.Size = UDim2.new(0, CONFIG.BackAlertSize, 0, CONFIG.BackAlertSize)
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.BackgroundColor3 = CONFIG.BackAlertColor
    f.BorderSizePixel = 0; f.Visible = false; f.ZIndex = 10
    f.Parent = alertGui
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = f
    local s = Instance.new("UIStroke"); s.Name = "AlertStroke"; s.Color = Color3.fromRGB(255, 255, 255)
    s.Thickness = CONFIG.BackAlertStroke; s.Parent = f
    alertMarkers[player] = f
    return f
end

local function removeAlertMarker(player)
    if alertMarkers[player] then alertMarkers[player]:Destroy(); alertMarkers[player] = nil end
end

local function applyAlertStyles()
    for p, m in pairs(alertMarkers) do
        m.Size = UDim2.new(0, CONFIG.BackAlertSize, 0, CONFIG.BackAlertSize)
        local s = m:FindFirstChild("AlertStroke")
        if s then s.Thickness = CONFIG.BackAlertStroke end
        m.BackgroundColor3 = getAlertColor(p)
    end
end

local function hideAllAlerts()
    for _, m in pairs(alertMarkers) do m.Visible = false end
end

local function updateBackAlerts()
    if not CONFIG.BackAlertEnabled then
        for _, m in pairs(alertMarkers) do m.Visible = false end
        return
    end
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local radiusX = vp.X * CONFIG.BackAlertRadiusX
    local radiusY = vp.Y * CONFIG.BackAlertRadiusY
    local camCF = Camera.CFrame
    local camPos = camCF.Position
    local forward = camCF.LookVector
    local right = camCF.RightVector

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer or not shouldShow(player) then
            local m = alertMarkers[player]; if m then m.Visible = false end
            continue
        end
        local model = getPlayerModel(player)
        local m = getAlertMarker(player)
        if not model then m.Visible = false; continue end
        local head = model:FindFirstChild("Head") or getAnyPart(model)
        if not head then m.Visible = false; continue end
        local toPlayer = head.Position - camPos
        if toPlayer.Magnitude < 0.1 then m.Visible = false; continue end
        local dir = toPlayer.Unit
        local dot = forward:Dot(dir)
        if dot >= 0 then m.Visible = false; continue end
        local az = math.atan2(dir:Dot(right), dot)
        local sx = center.X + math.sin(az) * radiusX
        local sy = center.Y - math.cos(az) * radiusY
        m.Position = UDim2.new(0, sx, 0, sy)
        
        m.BackgroundColor3 = getAlertColor(player)
        
        m.Visible = true
    end
end

