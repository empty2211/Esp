local function rgbToHex(c)
    local r = math.floor(c.R * 255 + 0.5)
    local g = math.floor(c.G * 255 + 0.5)
    local b = math.floor(c.B * 255 + 0.5)
    return string.format("#%02x%02x%02x", r, g, b)
end

local function hexToRgb(hex)
    local cleanHex = string.gsub(hex, "#", "")
    if #cleanHex == 3 then
        cleanHex = string.sub(cleanHex,1,1)..string.sub(cleanHex,1,1) .. string.sub(cleanHex,2,2)..string.sub(cleanHex,2,2) .. string.sub(cleanHex,3,3)..string.sub(cleanHex,3,3)
    end
    if #cleanHex ~= 6 then return nil end
    local r = tonumber(string.sub(cleanHex, 1, 2), 16)
    local g = tonumber(string.sub(cleanHex, 3, 4), 16)
    local b = tonumber(string.sub(cleanHex, 5, 6), 16)
    if r and g and b then return Color3.fromRGB(r, g, b) end
    return nil
end

local function applyUITheme()
    main.BackgroundColor3 = CONFIG.UI_BgColor
    main.BackgroundTransparency = CONFIG.UI_BgTrans
    
    titleBar.BackgroundColor3 = CONFIG.UI_BgColor
    titleBar.BackgroundTransparency = math.min(1, CONFIG.UI_BgTrans + 0.05)
    tbFix.BackgroundColor3 = CONFIG.UI_BgColor
    tbFix.BackgroundTransparency = math.min(1, CONFIG.UI_BgTrans + 0.05)
    
    sidebar.BackgroundColor3 = CONFIG.UI_BgColor
    sidebar.BackgroundTransparency = math.min(1, CONFIG.UI_BgTrans + 0.05)
    
    accentBar.BackgroundColor3 = CONFIG.UI_Accent
    mainStroke.Color = CONFIG.UI_Accent
    
    if aimButton then
        abStroke.Color = CONFIG.UI_Accent
        aimButton.TextSize = CONFIG.UI_TextSize
        aimButton.TextTransparency = CONFIG.UI_TextTrans
        updateAimButtonVisual()
    end
    
    if _G.__espMenuBtn then
        for _, child in ipairs(_G.__espMenuBtn:GetChildren()) do
            if child:IsA("TextButton") then
                child.TextTransparency = CONFIG.UI_TextTrans
                child.TextSize = CONFIG.UI_TextSize + 10
                local stroke = child:FindFirstChildOfClass("UIStroke")
                if stroke then stroke.Color = CONFIG.UI_Accent end
            end
        end
    end

    for _, desc in ipairs(main:GetDescendants()) do
        if desc.Name == "TabIndicator" or desc.Name == "SliderFill" then
            if desc:IsA("Frame") then desc.BackgroundColor3 = CONFIG.UI_Accent end
        elseif desc.Name == "SliderValue" then
            if desc:IsA("TextLabel") then
                desc.TextColor3 = CONFIG.UI_Accent
                desc.TextTransparency = CONFIG.UI_TextTrans
                desc.TextSize = CONFIG.UI_TextSize - 1
            end
        elseif desc.Name == "ToggleBtn" then
            if desc:IsA("TextButton") then
                if desc:GetAttribute("State") then desc.BackgroundColor3 = CONFIG.UI_Accent end
                desc.TextTransparency = CONFIG.UI_TextTrans
            end
        elseif desc.Name == "MainStroke" or desc.Name == "AimStroke" or desc.Name == "MobileStroke" then
            if desc:IsA("UIStroke") then desc.Color = CONFIG.UI_Accent end
        elseif desc.Name == "Row" then
            if desc:IsA("Frame") then
                desc.BackgroundColor3 = Color3.fromRGB(26, 26, 32)
                desc.BackgroundTransparency = math.min(1, CONFIG.UI_BgTrans + 0.05)
            end
        elseif desc:IsA("TextLabel") then
            desc.TextTransparency = CONFIG.UI_TextTrans
            desc.TextSize = CONFIG.UI_TextSize
        end
    end
end

