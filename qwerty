    btn.Size = UDim2.new(1, 0, 0, 28); btn.BackgroundColor3 = Color3.fromRGB(26, 26, 32); btn.BackgroundTransparency = 1; btn.Text = "  " .. name
    btn.TextColor3 = TEXT_DIM; btn.Font = Enum.Font.GothamMedium; btn.TextSize = CONFIG.UI_TextSize; btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.BorderSizePixel = 0; btn.AutoButtonColor = false; btn.Parent = sidebar
    btn.TextTransparency = CONFIG.UI_TextTrans
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 4); c.Parent = btn
    local indicator = Instance.new("Frame")
    indicator.Name = "TabIndicator"
    indicator.Size = UDim2.new(0, 2, 0, 14); indicator.Position = UDim2.new(0, 0, 0.5, -7); indicator.BackgroundColor3 = CONFIG.UI_Accent
    indicator.BorderSizePixel = 0; indicator.Visible = false; indicator.Parent = btn
    local ic = Instance.new("UICorner"); ic.CornerRadius = UDim.new(1, 0); ic.Parent = indicator
    btn.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do p.Visible = false end
        for _, sib in ipairs(sidebar:GetChildren()) do
            if sib:IsA("TextButton") then
                sib.BackgroundTransparency = 1; sib.TextColor3 = TEXT_DIM
                local ind = sib:FindFirstChildOfClass("Frame"); if ind then ind.Visible = false end
            end
        end
        if pages[pageName] then pages[pageName].Visible = true end
        btn.BackgroundTransparency = 0; btn.TextColor3 = TEXT_MAIN; indicator.Visible = true
    end)
    return btn
end

