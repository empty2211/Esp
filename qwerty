end

local function enableAllESP()
    for _, p in ipairs(Players:GetPlayers()) do addHighlightsFor(p) end
end

-- PLAYER SETUP
local function setupPlayer(player)
    if player == LocalPlayer then return end
    track(player.CharacterAdded:Connect(function()
        visibility[player] = true
        task.wait(0.5)
        if _G.__espKill.dead then return end
        addHighlightsFor(player)
    end))
    track(player.CharacterRemoving:Connect(function()
        removeHighlightsFor(player); hideESPDrawings(player)
    end))
    track(player:GetPropertyChangedSignal("Team"):Connect(function()
        if _G.__espKill.dead then return end
        addHighlightsFor(player)
    end))
    if player.Character then
        visibility[player] = true
        task.spawn(function()
            task.wait(0.5)
            if _G.__espKill.dead then return end
            addHighlightsFor(player)
        end)
    end
end

for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
track(Players.PlayerAdded:Connect(function(p) visibility[p] = true; setupPlayer(p) end))
track(Players.PlayerRemoving:Connect(function(player)
    removeHighlightsFor(player); removeTracer(player)
    removeAlertMarker(player); removeESPDrawings(player)
    visibility[player] = nil
end))

-- VISIBILITY LOOP
track(RunService.Heartbeat:Connect((function()
    local acc = 0
    return function(dt)
        if _G.__espKill.dead then return end
        acc = acc + dt
        if acc < CONFIG.VisibilityCheckRate then return end
        acc = 0
        if not ESP_ENABLED then return end
        if not VISIBILITY_ENABLED then
            for _, p in ipairs(Players:GetPlayers()) do visibility[p] = true end
        else
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then visibility[p] = checkVisibility(p) end
            end
        end
        for _, p in ipairs(Players:GetPlayers()) do updateHighlightColor(p) end
    end
end)()))

-- ESP RENDER
local function renderTracers()
    if not CONFIG.TracerEnabled or not ESP_ENABLED then
        for _, line in pairs(tracers) do pcall(function() line.Visible = false end) end
        return
    end
    local vp = Camera.ViewportSize
    local origin = CONFIG.TracerFromBottom and Vector2.new(vp.X / 2, vp.Y) or Vector2.new(vp.X / 2, vp.Y / 2)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer or not shouldShow(player) then
            local line = tracers[player]; if line then line.Visible = false end
            continue
        end
        local model = getPlayerModel(player)
        local line = getTracer(player)
        if not line then continue end
        if not model then line.Visible = false; continue end
        local head = model:FindFirstChild("Head") or getAnyPart(model)
        if not head then line.Visible = false; continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen or screenPos.Z <= 0 then line.Visible = false; continue end
        
        line.Color = getESPColor(player)
        line.From = origin
        line.To = Vector2.new(screenPos.X, screenPos.Y)
        line.Visible = true
    end
end

RunService:BindToRenderStep("ESP_Render", Enum.RenderPriority.Camera.Value + 2, function()
    if _G.__espKill.dead then return end
    if not ESP_ENABLED then
        for _, line in pairs(tracers) do pcall(function() line.Visible = false end) end
        hideAllAlerts()
        for _, p in ipairs(Players:GetPlayers()) do hideESPDrawings(p) end
        return
    end
    renderTracers()
    updateBackAlerts()
    for _, p in ipairs(Players:GetPlayers()) do updateESPDrawings(p) end
end)

-- AIM
local function getAimTargetPart()
    if not CONFIG.AimEnabled or not AIM_ACTIVE then return nil end
    local center = getAimCenter()
    local best, bestDist = nil, CONFIG.AimFOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if CONFIG.Aim_TeamCheck and isSameTeam(p, LocalPlayer) then continue end
        local model = getPlayerModel(p)
        if not model then continue end
        local hum = getAnyHumanoid(model)
        if not hum or hum.Health <= 0 then continue end
        local part = model:FindFirstChild(CONFIG.AimTargetPart)
        if not (part and part:IsA("BasePart")) then
            part = model:FindFirstChild("Head") or getAnyPart(model)
        end
        if not part then continue end
        if CONFIG.AimVisibleOnly and not effectiveVisible(p) then continue end
        local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen or sp.Z <= 0 then continue end
        local dx = sp.X - center.X
        local dy = sp.Y - center.Y
        local dist = math.sqrt(dx * dx + dy * dy)
        if dist < bestDist then bestDist = dist; best = part end
    end
    return best
end

RunService:BindToRenderStep("AIM_Render", Enum.RenderPriority.Camera.Value + 1, function()
    if _G.__espKill.dead then return end
    if CONFIG.AimDrawFOV and CONFIG.AimEnabled and AIM_ACTIVE then
        local center = getAimCenter()
        fovCircle.Position = UDim2.new(0, center.X, 0, center.Y)
        fovCircle.Visible = true
    else
        fovCircle.Visible = false
    end
    if not CONFIG.AimEnabled or not AIM_ACTIVE then return end
    local target = getAimTargetPart()
    if not target then return end
    local camPos = Camera.CFrame.Position
    local targetPos = target.Position
    if CONFIG.AimPrediction > 0 then
        local vel = target.AssemblyLinearVelocity
        if vel then targetPos = targetPos + vel * CONFIG.AimPrediction end
    end
    local dir = (targetPos - camPos).Unit
    local desired = CFrame.lookAt(camPos, camPos + dir)
    local alpha = 1 - math.clamp(CONFIG.AimSmoothness, 0, 0.99)
    Camera.CFrame = Camera.CFrame:Lerp(desired, alpha)
end)

