local updateBrightnessSlider = nil

local gridRes = 30
local cellSize = pickerSize / gridRes
local colorCells = {}
local maxDist = (gridRes - 1) / 2

for y = 0, gridRes - 1 do
    for x = 0, gridRes - 1 do
        local dx = x - maxDist
        local dy = y - maxDist
        local dist = math.sqrt(dx*dx + dy*dy)

        if dist <= maxDist + 0.5 then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(0, cellSize + 1, 0, cellSize + 1) 
            btn.Position = UDim2.new(0, x * cellSize - 0.5, 0, y * cellSize - 0.5)
            btn.Text = ""
            btn.BorderSizePixel = 0
            
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(1, 0)
            btnCorner.Parent = btn

            local h = (math.atan2(dy, dx) / (2 * math.pi)) % 1
            local s = math.clamp(dist / maxDist, 0, 1)
            
            btn.BackgroundColor3 = Color3.fromHSV(h, s, 1) 
            btn.Parent = pickerFrame
            btn.MouseButton1Click:Connect(function()
                if CONFIG.UI_Value < 0.05 then
                    CONFIG.UI_Value = 1
                    if updateBrightnessSlider then updateBrightnessSlider(1) end
                end
                CONFIG.UI_Accent = Color3.fromHSV(h, s, CONFIG.UI_Value)
                rgbBox.Text = string.format("%d, %d, %d", math.floor(CONFIG.UI_Accent.R*255+0.5), math.floor(CONFIG.UI_Accent.G*255+0.5), math.floor(CONFIG.UI_Accent.B*255+0.5))
                hexBox.Text = rgbToHex(CONFIG.UI_Accent)
                applyUITheme()
                pickerFrame.Visible = false
            end)
            table.insert(colorCells, {btn = btn, h = h, s = s})
        end
    end
end

