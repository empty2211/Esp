-- ============================================================
-- УНИВЕРСАЛЬНЫЙ ПОИСК МОДЕЛИ ИГРОКА (скины)
-- ============================================================
local function isPlayerModel(obj, player)
    if not obj or not obj:IsA("Model") then return false end
    local uid = obj:GetAttribute("Player")
        or obj:GetAttribute("UserId")
        or obj:GetAttribute("Owner")
        or obj:GetAttribute("PlayerId")
    if uid ~= nil then
        if uid == player.UserId or uid == player.Name then return true end
    end
    if obj.Name == player.Name then return true end
    if obj.Name:find(player.Name, 1, true) then return true end
    return false
end

local function getPlayerModel(player)
    if player == LocalPlayer then return nil end

    local char = player.Character
    if char and char.Parent and char:FindFirstChildOfClass("Humanoid") then
        return char
    end

    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
            if isPlayerModel(obj, player) then
                return obj
            end
        end
    end

    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name == player.Name then
            return obj
        end
    end

    return char
end

local function getAnyHumanoid(model)
    if not model then return nil end
    return model:FindFirstChildOfClass("Humanoid")
        or (model.Parent and model.Parent:FindFirstChildOfClass("Humanoid"))
end

local function getAnyPart(model, preferName)
    if not model then return nil end
    if preferName then
        local p = model:FindFirstChild(preferName)
        if p and p:IsA("BasePart") then return p end
    end
    local hrp = model:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then return hrp end
    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BasePart") then return obj end
    end
    return nil
end

-- ============================================================
-- TEAM
-- ============================================================
local function isSameTeam(p1, p2)
    if p1 == p2 then return true end
    local t1, t2 = p1.Team, p2.Team
    if t1 ~= nil and t2 ~= nil then return t1 == t2 end
    local a1 = p1:GetAttribute("Team") or p1:GetAttribute("TeamName")
    local a2 = p2:GetAttribute("Team") or p2:GetAttribute("TeamName")
    if a1 ~= nil and a2 ~= nil then return a1 == a2 end
    return false
end

local function shouldShow(player)
    if player == LocalPlayer then return false end
    if CONFIG.ESP_TeamCheck and isSameTeam(player, LocalPlayer) then return false end
    return true
end

local function effectiveVisible(player)
    if not VISIBILITY_ENABLED then return true end
    local v = visibility[player]
    if v == nil then return true end
    return v == true
end

-- ============================================================
-- VISIBILITY
-- ============================================================
local function raycastVisible(targetModel, checkPoint)
    if not targetModel or not checkPoint then return false end
    local camPos = Camera.CFrame.Position
    local dir = checkPoint.Position - camPos
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    params.IgnoreWater = true
    local result = Workspace:Raycast(camPos, dir, params)
    if not result then return true end
    if result.Instance:IsDescendantOf(targetModel) then return true end
    return false
end

local function checkVisibility(player)
    if not shouldShow(player) then return false end
    local model = getPlayerModel(player)
    if not model then return false end

    local head = model:FindFirstChild("Head") or getAnyPart(model, "Head")
    if head and raycastVisible(model, head) then return true end

    if not CONFIG.CheckHeadOnly then
        local torso = model:FindFirstChild("UpperTorso")
            or model:FindFirstChild("Torso")
            or getAnyPart(model)
        if torso and raycastVisible(model, torso) then return true end
    end
    return false
end

-- ============================================================
-- HIGHLIGHT
-- ============================================================
local function removeHighlightsFor(player)
    if highlights[player] then
        highlights[player]:Destroy()
        highlights[player] = nil
    end
end

local function addHighlightsFor(player)
    if not ESP_ENABLED or not shouldShow(player) then
        removeHighlightsFor(player)
        return
    end
    local model = getPlayerModel(player)
    if not model then return end

    removeHighlightsFor(player)

    if CONFIG.UseHighlight then
        local h = Instance.new("Highlight")
        h.Name = "ESP_HL_" .. player.Name
        h.FillColor = effectiveVisible(player) and CONFIG.VisibleColor or CONFIG.HiddenColor
        h.OutlineColor = CONFIG.OutlineColor
        h.FillTransparency = CONFIG.Transparency
        h.OutlineTransparency = CONFIG.OutlineTransparency
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Adornee = model
        h.Parent = Workspace
        highlights[player] = h
    end
end

local function applyHighlightStyles()
    for _, h in pairs(highlights) do
        if h and h.Parent then
            h.FillTransparency = CONFIG.Transparency
            h.OutlineTransparency = CONFIG.OutlineTransparency
            h.OutlineColor = CONFIG.OutlineColor
        end
    end
end

local function updateHighlightColor(player)
    local vis = effectiveVisible(player)
    local col = vis and CONFIG.VisibleColor or CONFIG.HiddenColor
    local h = highlights[player]
    if h and h.Parent then h.FillColor = col end
end

-- ============================================================
-- TRACER
-- ============================================================
local function applyTracerStyles()
    for _, line in pairs(tracers) do
        pcall(function()
            line.Thickness = CONFIG.TracerThickness
            line.Transparency = CONFIG.TracerTransparency
        end)
    end
end

local function getTracer(player)
    if not CONFIG.TracerEnabled then return nil end
    if not tracers[player] then
        local ok, line = pcall(function() return Drawing.new("Line") end)
        if not ok or not line then return nil end
        line.Thickness = CONFIG.TracerThickness
        line.Transparency = CONFIG.TracerTransparency
        line.Color = CONFIG.VisibleColor
        line.Visible = false
        tracers[player] = line
    end
    return tracers[player]
end

local function removeTracer(player)
    if tracers[player] then
        pcall(function() tracers[player]:Remove() end)
        tracers[player] = nil
    end
end

