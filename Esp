-- ============================================================
-- PLAYER SETUP
-- ============================================================
local function setupPlayer(player)
    if player == LocalPlayer then return end

    track(player.CharacterAdded:Connect(function()
        visibility[player] = true
        task.wait(0.5)
        if _G.__espKill.dead then return end
        addHighlightsFor(player)
    end))

    track(player.CharacterRemoving:Connect(function()
        removeHighlightsFor(player)
        hideESPDrawings(player)
    end))

    track(player:GetPropertyChangedSignal("Team"):Connect(function()
        if _G.__espKill.dead then return end
        addHighlightsFor(player)
    end))

    if player.Character then
        visibility[player] = true
        task.spawn(function()
            task.wait(0.5)
            if _G.__espKill.dead then return end
            addHighlightsFor(player)
        end)
    end
end

for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
track(Players.PlayerAdded:Connect(function(p)
    visibility[p] = true
    setupPlayer(p)
end))
track(Players.PlayerRemoving:Connect(function(player)
    removeHighlightsFor(player)
    removeTracer(player)
    removeAlertMarker(player)
    removeESPDrawings(player)
    visibility[player] = nil
end))

-- ============================================================
-- VISIBILITY LOOP
-- ============================================================
track(RunService.Heartbeat:Connect((function()
    local acc = 0
    return function(dt)
        if _G.__espKill.dead then return end
        acc = acc + dt
        if acc < CONFIG.VisibilityCheckRate then return end
        acc = 0

        if not ESP_ENABLED then return end

        if not VISIBILITY_ENABLED then
            for _, p in ipairs(Players:GetPlayers()) do visibility[p] = true end
        else
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then visibility[p] = checkVisibility(p) end
            end
        end
        for _, p in ipairs(Players:GetPlayers()) do updateHighlightColor(p) end
    end
end)()))

-- ============================================================
-- ESP RENDER
-- ============================================================
local function renderTracers()
    if not CONFIG.TracerEnabled or not ESP_ENABLED then
        for _, line in pairs(tracers) do
            pcall(function() line.Visible = false end)
        end
        return
    end

    local vp = Camera.ViewportSize
    local origin = CONFIG.TracerFromBottom
        and Vector2.new(vp.X / 2, vp.Y)
        or Vector2.new(vp.X / 2, vp.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer or not shouldShow(player) then
            local line = tracers[player]
            if line then line.Visible = false end
            continue
        end

        local model = getPlayerModel(player)
        local line = getTracer(player)
        if not line then continue end
        if not model then line.Visible = false; continue end

        local head = model:FindFirstChild("Head") or getAnyPart(model)
        if not head then line.Visible = false; continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen or screenPos.Z <= 0 then
            line.Visible = false
            continue
        end

        line.Color = effectiveVisible(player) and CONFIG.VisibleColor or CONFIG.HiddenColor
        line.From = origin
        line.To = Vector2.new(screenPos.X, screenPos.Y)
        line.Visible = true
    end
end

RunService:BindToRenderStep("ESP_Render", Enum.RenderPriority.Camera.Value + 2, function()
    if _G.__espKill.dead then return end
    if not ESP_ENABLED then
        for _, line in pairs(tracers) do
            pcall(function() line.Visible = false end)
        end
        hideAllAlerts()
        for _, p in ipairs(Players:GetPlayers()) do hideESPDrawings(p) end
        return
    end
    renderTracers()
    updateBackAlerts()
    for _, p in ipairs(Players:GetPlayers()) do updateESPDrawings(p) end
end)

