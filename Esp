-- BOX + HP (Drawing)
-- ============================================================
local function makeESPDrawings()
    local ok = pcall(function() return Drawing.new("Square") end)
    if not ok then return nil end

    local box = Drawing.new("Square")
    box.Filled = false
    box.Visible = false

    local hpBg = Drawing.new("Square")
    hpBg.Filled = true
    hpBg.Color = Color3.fromRGB(0, 0, 0)
    hpBg.Visible = false

    local hpFill = Drawing.new("Square")
    hpFill.Filled = true
    hpFill.Visible = false

    local hpText = Drawing.new("Text")
    hpText.Center = true
    hpText.Outline = true
    hpText.OutlineColor = Color3.fromRGB(0, 0, 0)
    hpText.Size = 13
    hpText.Font = Drawing.Fonts.UI
    hpText.Visible = false

    local distText = Drawing.new("Text")
    distText.Center = true
    distText.Outline = true
    distText.OutlineColor = Color3.fromRGB(0, 0, 0)
    distText.Size = 13
    distText.Font = Drawing.Fonts.UI
    distText.Visible = false

    return {
        box = box,
        hpBg = hpBg,
        hpFill = hpFill,
        hpText = hpText,
        distText = distText,
    }
end

local function getESPDrawings(player)
    if not espObjects[player] then
        espObjects[player] = makeESPDrawings()
    end
    return espObjects[player]
end

local function removeESPDrawings(player)
    local d = espObjects[player]
    if d then
        for _, obj in pairs(d) do
            pcall(function() obj:Remove() end)
        end
        espObjects[player] = nil
    end
end

local function hideESPDrawings(player)
    local d = espObjects[player]
    if not d then return end
    d.box.Visible = false
    d.hpBg.Visible = false
    d.hpFill.Visible = false
    d.hpText.Visible = false
    d.distText.Visible = false
end

local function updateESPDrawings(player)
    local d = getESPDrawings(player)
    if not d then return end

    if not ESP_ENABLED or not shouldShow(player) then
        hideESPDrawings(player); return
    end

    local model = getPlayerModel(player)
    if not model then hideESPDrawings(player); return end

    local hum = getAnyHumanoid(model)
    if not hum then hideESPDrawings(player); return end

    local headPart = model:FindFirstChild("Head") or getAnyPart(model, "Head")
    local rootPart = model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
        or getAnyPart(model)

    if not headPart or not rootPart then
        local top, bot
        for _, obj in ipairs(model:GetDescendants()) do
            if obj:IsA("BasePart") then
                if not top or obj.Position.Y > top.Position.Y then top = obj end
                if not bot or obj.Position.Y < bot.Position.Y then bot = obj end
            end
        end
        headPart = headPart or top
        rootPart = rootPart or bot
    end

    if not headPart then hideESPDrawings(player); return end

    local topPos = headPart.Position + Vector3.new(0, 0.6, 0)

    local hip = 2.5
    if hum then hip = hum.HipHeight or 2.5 end
    local botPos = Vector3.new(rootPart.Position.X,
        rootPart.Position.Y - hip, rootPart.Position.Z)

    local spTop = Camera:WorldToViewportPoint(topPos)
    local spBot = Camera:WorldToViewportPoint(botPos)

    if spTop.Z <= 0 and spBot.Z <= 0 then
        hideESPDrawings(player); return
    end

    local topX, topY, topZ = spTop.X, spTop.Y, spTop.Z
    local botX, botY, botZ = spBot.X, spBot.Y, spBot.Z
    if topZ <= 0 then topY = botY - 100; topX = botX end
    if botZ <= 0 then botY = topY + 100; botX = topX end

    local yTop = math.min(topY, botY)
    local yBot = math.max(topY, botY)
    local boxH = yBot - yTop
    if boxH < 3 then hideESPDrawings(player); return end

    local boxW = boxH * CONFIG.BoxWidthRatio
    local xCenter = (topX + botX) / 2
    local xLeft = xCenter - boxW / 2

    local vis = effectiveVisible(player)
    local boxColor = vis and CONFIG.VisibleColor or CONFIG.HiddenColor

    -- ===== BOX =====
    if CONFIG.BoxEnabled then
        d.box.Visible = true
        d.box.Position = Vector2.new(xLeft, yTop)
        d.box.Size = Vector2.new(boxW, boxH)
        d.box.Thickness = CONFIG.BoxThickness
        d.box.Color = boxColor
        d.box.Transparency = CONFIG.BoxTransparency
    else
        d.box.Visible = false
    end

    local barH = CONFIG.HPBarHeight
    local hpPct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)

    -- ===== HP BAR — НАД БОКСОМ =====
    local barY = yTop - barH - 3

    if CONFIG.HPBarEnabled then
        d.hpBg.Visible = true
        d.hpBg.Position = Vector2.new(xLeft, barY)
        d.hpBg.Size = Vector2.new(boxW, barH)
        d.hpBg.Color = Color3.fromRGB(0, 0, 0)
        d.hpBg.Transparency = CONFIG.HPTransparency

        d.hpFill.Visible = true
        d.hpFill.Position = Vector2.new(xLeft, barY)
        d.hpFill.Size = Vector2.new(boxW * hpPct, barH)
        d.hpFill.Color = Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(60, 255, 60), hpPct)
        d.hpFill.Transparency = CONFIG.HPTransparency
    else
        d.hpBg.Visible = false
        d.hpFill.Visible = false
    end

    -- ===== HP TEXT — над HP-баром =====
    if CONFIG.HPTextEnabled then
        d.hpText.Visible = true
        d.hpText.Position = Vector2.new(xLeft + boxW / 2, barY - 15)
        d.hpText.Text = string.format("%d / %d",
            math.floor(hum.Health + 0.5), math.floor(hum.MaxHealth + 0.5))
        d.hpText.Color = Color3.fromRGB(255, 255, 255)
        d.hpText.Transparency = CONFIG.HPTransparency
    else
        d.hpText.Visible = false
    end

    -- ===== DISTANCE (метры) — ПОД БОКСОМ =====
    local myChar = LocalPlayer.Character
    local myRoot = myChar and (
        myChar:FindFirstChild("HumanoidRootPart")
        or myChar:FindFirstChild("UpperTorso")
        or myChar:FindFirstChild("Torso")
    )

    local dist = 0
    if myRoot and rootPart then
        dist = (rootPart.Position - myRoot.Position).Magnitude
    end

    if CONFIG.DistTextEnabled then
        d.distText.Visible = true
        d.distText.Position = Vector2.new(xLeft + boxW / 2, yBot + 4)
        d.distText.Text = string.format("%d m", math.floor(dist + 0.5))
        d.distText.Color = Color3.fromRGB(255, 255, 255)
        d.distText.Transparency = CONFIG.HPTransparency
    else
        d.distText.Visible = false
    end
end

