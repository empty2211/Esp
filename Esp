local function getAimTargetPart()
    if not CONFIG.AimEnabled or not AIM_ACTIVE then return nil end

    local center = getAimCenter()
    local best, bestDist = nil, CONFIG.AimFOV

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if CONFIG.Aim_TeamCheck and isSameTeam(p, LocalPlayer) then continue end

        local model = getPlayerModel(p)
        if not model then continue end

        local hum = getAnyHumanoid(model)
        if not hum or hum.Health <= 0 then continue end

        local part = model:FindFirstChild(CONFIG.AimTargetPart)
        if not (part and part:IsA("BasePart")) then
            part = model:FindFirstChild("Head") or getAnyPart(model)
        end
        if not part then continue end

        if CONFIG.AimVisibleOnly and not effectiveVisible(p) then continue end

        local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen or sp.Z <= 0 then continue end

        local dx = sp.X - center.X
        local dy = sp.Y - center.Y
        local dist = math.sqrt(dx * dx + dy * dy)

        if dist < bestDist then
            bestDist = dist
            best = part
        end
    end

    return best
end

RunService:BindToRenderStep("AIM_Render", Enum.RenderPriority.Camera.Value + 1, function()
    if _G.__espKill.dead then return end

    if CONFIG.AimDrawFOV and CONFIG.AimEnabled and AIM_ACTIVE then
        local center = getAimCenter()
        fovCircle.Position = UDim2.new(0, center.X, 0, center.Y)
        fovCircle.Visible = true
    else
        fovCircle.Visible = false
    end

    if not CONFIG.AimEnabled or not AIM_ACTIVE then return end

    local target = getAimTargetPart()
    if not target then return end

    local camPos = Camera.CFrame.Position
    local targetPos = target.Position

    if CONFIG.AimPrediction > 0 then
        local vel = target.AssemblyLinearVelocity
        if vel then targetPos = targetPos + vel * CONFIG.AimPrediction end
    end

    local dir = (targetPos - camPos).Unit
    local desired = CFrame.lookAt(camPos, camPos + dir)

    local alpha = 1 - math.clamp(CONFIG.AimSmoothness, 0, 0.99)
    Camera.CFrame = Camera.CFrame:Lerp(desired, alpha)
end)

