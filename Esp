local alertGui = Instance.new("ScreenGui")
alertGui.Name = "ESP_BackAlert"
alertGui.IgnoreGuiInset = true
alertGui.ResetOnSpawn = false
alertGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local alertMarkers = {}

local function getAlertMarker(player)
    if alertMarkers[player] then return alertMarkers[player] end
    local f = Instance.new("Frame")
    f.Name = "Alert_" .. player.Name
    f.Size = UDim2.new(0, CONFIG.BackAlertSize, 0, CONFIG.BackAlertSize)
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.BackgroundColor3 = CONFIG.BackAlertColor
    f.BorderSizePixel = 0
    f.Visible = false
    f.ZIndex = 10
    f.Parent = alertGui

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = f

    local s = Instance.new("UIStroke")
    s.Name = "AlertStroke"
    s.Color = Color3.fromRGB(255, 255, 255)
    s.Thickness = CONFIG.BackAlertStroke
    s.Parent = f

    alertMarkers[player] = f
    return f
end

local function removeAlertMarker(player)
    if alertMarkers[player] then
        alertMarkers[player]:Destroy()
        alertMarkers[player] = nil
    end
end

local function applyAlertStyles()
    for _, m in pairs(alertMarkers) do
        m.Size = UDim2.new(0, CONFIG.BackAlertSize, 0, CONFIG.BackAlertSize)
        local s = m:FindFirstChild("AlertStroke")
        if s then s.Thickness = CONFIG.BackAlertStroke end
        m.BackgroundColor3 = CONFIG.BackAlertColor
    end
end

local function hideAllAlerts()
    for _, m in pairs(alertMarkers) do m.Visible = false end
end

local function updateBackAlerts()
    if not CONFIG.BackAlertEnabled then
        for _, m in pairs(alertMarkers) do m.Visible = false end
        return
    end

    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local radiusX = vp.X * CONFIG.BackAlertRadiusX
    local radiusY = vp.Y * CONFIG.BackAlertRadiusY

    local camCF = Camera.CFrame
    local camPos = camCF.Position
    local forward = camCF.LookVector
    local right = camCF.RightVector

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer or not shouldShow(player) then
            local m = alertMarkers[player]
            if m then m.Visible = false end
            continue
        end

        local model = getPlayerModel(player)
        local m = getAlertMarker(player)

        if not model then m.Visible = false; continue end

        local head = model:FindFirstChild("Head") or getAnyPart(model)
        if not head then m.Visible = false; continue end

        local toPlayer = head.Position - camPos
        if toPlayer.Magnitude < 0.1 then m.Visible = false; continue end

        local dir = toPlayer.Unit
        local dot = forward:Dot(dir)
        if dot >= 0 then m.Visible = false; continue end

        local az = math.atan2(dir:Dot(right), dot)
        local sx = center.X + math.sin(az) * radiusX
        local sy = center.Y - math.cos(az) * radiusY

        m.Position = UDim2.new(0, sx, 0, sy)
        m.Visible = true
    end
end

