    valLbl.Size = UDim2.new(0, 55, 0, 16)
    valLbl.Position = UDim2.new(1, -67, 0, 3)
    valLbl.BackgroundTransparency = 1
    valLbl.Text = isFloat and string.format("%.2f", initial) or tostring(initial)
    valLbl.TextColor3 = ACCENT
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 11
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.Parent = row

    local st = Instance.new("Frame")
    st.Size = UDim2.new(1, -24, 0, 5)
    st.Position = UDim2.new(0, 12, 0, 26)
    st.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
    st.BorderSizePixel = 0
    st.Parent = row

    local tc = Instance.new("UICorner")
    tc.CornerRadius = UDim.new(1, 0)
    tc.Parent = st

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = ACCENT
    fill.BorderSizePixel = 0
    fill.Parent = st

    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(1, 0)
    fc.Parent = fill

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.ZIndex = 2
    knob.Parent = st

    local kc = Instance.new("UICorner")
    kc.CornerRadius = UDim.new(1, 0)
    kc.Parent = knob

    local value = initial
    local dragging = false

    local function setValue(v)
        value = math.clamp(v, min, max)
        local alpha = (value - min) / (max - min)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        valLbl.Text = isFloat and string.format("%.2f", value) or tostring(math.floor(value + 0.5))
        if callback then callback(value) end
    end
    setValue(initial)

    local function upd(inp)
        local absPos = st.AbsolutePosition.X
        local absSize = st.AbsoluteSize.X
        if absSize <= 0 then return end
        local alpha = math.clamp((inp.Position.X - absPos) / absSize, 0, 1)
        setValue(min + (max - min) * alpha)
    end

    st.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            upd(input)
        end
    end)

    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch) then
            upd(input)
        end
    end))

    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    return row
end

